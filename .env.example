# Copy to .env.local for local development (gitignored). On Easel these are GitHub
# variables and secrets on the repo; see docs/easel.md.

# The AI (Ask the Village, email drafts, web leads) through the Playlab API; see docs/playlab-app.md.
PLAYLAB_API_KEY=""
PLAYLAB_PROJECT_ID=""
PLAYLAB_INSTRUCTIONS_IN_APP="true"

# Sign in with Playlab. Leave empty locally to use email + password (and DEMO_LOGIN).
# Register http://localhost:5173/auth/callback with the OpenID client.
PLAYLAB_URL=""
PLAYLAB_CLIENT_ID=""
PLAYLAB_CLIENT_SECRET=""
APP_URL="http://localhost:5173"

# Optional: connect mailboxes (openssl rand -base64 32), and the providers' OAuth clients.
EMAIL_TOKEN_KEY=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Optional: web search for new partners.
EXA_API_KEY=""

# Without DATABASE_URL, an embedded Postgres in .data/pglite is used.
# DATABASE_URL="postgres://postgres:postgres@localhost:5432/postgres"
